# =============================================================================
# Ghostty 终端配置 — v1.3.1
# =============================================================================

# ── 字体 ────────────────────────────────────────────────────────────────────
font-family = Ubuntu Sans Mono
font-size = 13
font-feature = calt

# ── 主题 ─────────────────────────────────────────────────────────────────────
# 用 ghostty +list-themes 查看所有内置主题
theme = TokyoNight Night

# ── 窗口 ────────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4
window-save-state = always
window-width = 100
window-height = 32
window-title-font-family = Ubuntu Sans

# ── 光标 ────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── 滚动 ────────────────────────────────────────────────────────────────────
scrollback-limit = 100000

# ── Shell 集成 ──────────────────────────────────────────────────────────────
shell-integration = zsh

# ── 复制粘贴 ────────────────────────────────────────────────────────────────
copy-on-select = clipboard

# ── 确认关闭 ────────────────────────────────────────────────────────────────
confirm-close-surface = true

# ── 快捷键 ──────────────────────────────────────────────────────────────────
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+shift+enter=toggle_fullscreen
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard
