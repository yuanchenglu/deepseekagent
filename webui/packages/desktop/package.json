{
  "name": "deepagent-desktop",
  "version": "0.6.22",
  "description": "DeepAgent and DeepCode dual-mode desktop client",
  "homepage": "https://deepseekagent.starseas.org",
  "author": {
    "name": "DeepAgent Contributors",
    "email": "noreply@starseas.org"
  },
  "license": "BSL-1.1",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:main",
    "dev": "npm run build:main && electron .",
    "dist": "npm run build && node scripts/electron-builder.mjs --mac --arm64",
    "dist:mac": "npm run build && node scripts/electron-builder.mjs --mac",
    "dist:preview": "npm run build && node scripts/electron-builder.mjs --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "tar": "^7.5.16"
  }
}
